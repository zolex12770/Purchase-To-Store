# =============================================================================
# ZOLEX production configuration — TEMPLATE
#
# Copy to `.env.deploy` and fill in. `.env.deploy` is git-ignored and MUST
# never be committed: it holds real credentials.
#
# `./deploy/install.sh` generates this file for you with strong random secrets.
# =============================================================================

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=zolex_production
POSTGRES_USER=zolex
# Generate: openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 32
POSTGRES_PASSWORD=CHANGE_ME

# ── Application ─────────────────────────────────────────────────────────────
# The public URL. Must match how users reach the app, or cookies will not stick.
FRONTEND_URL=https://erp.example.com
HTTP_PORT=80
HTTPS_PORT=443

# ── Secrets ─────────────────────────────────────────────────────────────────
# Generate each separately: openssl rand -base64 48
# They must be DIFFERENT from each other. Rotating them signs everyone out.
AUTH_SECRET=CHANGE_ME
AUTH_REFRESH_SECRET=CHANGE_ME

# ── Storage (must be OUTSIDE the source tree) ───────────────────────────────
ZOLEX_BACKUP_DIR=/var/lib/zolex/backups
TLS_CERT_DIR=/var/lib/zolex/certs

# ── Google Sheets (optional) ────────────────────────────────────────────────
# See docs/FINAL_GOOGLE_SHEETS_PRODUCTION_GUIDE.md §4.
# Leave all three blank to run without Google Sheets.
GOOGLE_SHEET_ID=1Dyj3Ws9gyR2zOe6p6RafQrKUFyLKIFN5h-3XDe9KD9I
# Host path to the service-account JSON. Mounted read-only into the container.
GOOGLE_KEY_HOST_PATH=
# Path INSIDE the container — leave exactly as below if you set the host path.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/run/secrets/google-sheets.json
