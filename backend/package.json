{
  "name": "zolex-erp-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ZOLEX Purchase-to-Store Enterprise ERP — backend API (Zeeta Electrical Engineering Pvt. Ltd.)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true}); require('fs').cpSync('src/assets','dist/assets',{recursive:true})\"",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/cli-migrate.ts",
    "seed": "tsx src/db/cli-seed.ts",
    "seed:demo": "tsx src/db/cli-seed.ts --demo",
    "db:reset": "tsx src/db/cli-reset.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:restore": "tsx src/db/cli-restore.ts",
    "db:doctor": "tsx src/db/cli-doctor.ts",
    "db:purify": "tsx src/db/cli-purify.ts",
    "db:reset-transactions": "tsx src/db/cli-reset-transactions.ts",
    "sync:now": "tsx src/db/cli-sync-now.ts",
    "db:backup": "tsx src/db/cli-backup.ts",
    "db:verify-restore": "tsx src/db/cli-verify-restore.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "googleapis": "^176.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "playwright": "^1.62.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "uuid": "^11.1.0"
  }
}
