# ─────────────────────────────────────────────────────────────────────────────
# ZOLEX Purchase-to-Store ERP — backend configuration
# Copy to `.env` and adjust. NEVER commit `.env` (see ../.gitignore).
# Environment validation fails fast on startup if a required value is missing.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# Seed synthetic demo transactions on start-up so the analytics screens have
# something to show. Ignored entirely when NODE_ENV=production.
#
# It is also ignored once the database has been purified
# (`npm run db:purify -- --apply`) or created clean (`npm run db:reset -- --clean`):
# a deliberate cleanup is never undone by a restart.
SEED_DEMO_DATA=true
PORT=6000
FRONTEND_URL=http://localhost:5173

# ── Persistent storage ───────────────────────────────────────────────────────
# MUST be outside the project source folder (SRS §19, §23, §26).
# The database, backups, uploads and logs all live under this root.
# Leave blank to default to <home>/ZolexERP
ZOLEX_DATA_ROOT=

# ── Database ─────────────────────────────────────────────────────────────────
# DB_DRIVER=pglite  → embedded PostgreSQL 18 (no server needed). Default.
#                     Stores data in $ZOLEX_DATA_ROOT/data
# DB_DRIVER=pg      → real PostgreSQL server. Requires DATABASE_URL below.
DB_DRIVER=pglite
# DATABASE_URL=postgresql://zolex:password@localhost:5432/zolex_erp
# DB_POOL_MAX=10

# ── Authentication ───────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production; auto-generated with a warning in development.
AUTH_SECRET=
AUTH_REFRESH_SECRET=
ACCESS_TOKEN_TTL=8h
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=15
# First-sign-in password (12+ characters) for the bootstrap administrators 10221 and
# 10422, used only when a new database creates them. Leave unset to have a random
# one written to $ZOLEX_DATA_ROOT/bootstrap-admin-password.txt (never to the log).
# Either way it must be changed at first sign-in; delete the file afterwards.
# BOOTSTRAP_ADMIN_PASSWORD=

# ── Google Sheets integration (SRS §8, §9) ───────────────────────────────────
# Leave blank to run without sync — the app degrades to a clear
# "not configured" state and never crashes.
GOOGLE_SHEET_ID=1Dyj3Ws9gyR2zOe6p6RafQrKUFyLKIFN5h-3XDe9KD9I
# Absolute path to a service-account JSON key, stored OUTSIDE the repository.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=C:\secure\google-service-account.json
# Alternative for a sheet shared as "anyone with the link can view":
GOOGLE_API_KEY=
GOOGLE_SYNC_INTERVAL_MINUTES=15

# ── Limits ───────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20
MAX_UPLOAD_MB=15
LOG_LEVEL=info
